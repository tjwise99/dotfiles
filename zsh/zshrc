# ~/.zshrc — interactive zsh. Deployed on every host.
#
# Plugins and prompt come from this repo, not /usr/share. Manjaro packages them
# and Ubuntu names them differently and puts them elsewhere, so sourcing by
# distro path would make this file behave according to which box it landed on.
# Pinned submodules under zsh/plugins/ give both hosts the same versions.
#
# Paths below are written out rather than built from a variable: tools/
# check-manifest.py vouches for a tracked file by finding its path as a literal
# string in a deployed one, and an interpolated prefix is never contiguous with
# the rest of the path in this file's text.

# Completion. Manjaro's stock config set this up; nothing on Ubuntu does.
mkdir -p "${HOME}/.cache/zsh"
autoload -U compinit colors zcalc
fpath+=("${HOME}/dotfiles/zsh/plugins/zsh-completions/src")
compinit -d "${HOME}/.cache/zsh/zcompdump"
colors
zstyle ':completion:*' cache-path "${HOME}/.cache/zsh/compcache"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ~/.p10k.zsh is Manjaro's own generated config, tracked as zsh/p10k.zsh so the
# prompt survives the move off /usr/share looking exactly as it did.
source "${HOME}/dotfiles/zsh/plugins/powerlevel10k/powerlevel10k.zsh-theme"
[[ -r "${HOME}/.p10k.zsh" ]] && source "${HOME}/.p10k.zsh"

source "${HOME}/dotfiles/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "${HOME}/dotfiles/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh"
# Last, per its README: it wraps widgets the plugins above define.
source "${HOME}/dotfiles/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

HISTFILE="${HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_dups share_history

# Ahead of the shared block so the sync health report lands underneath it
# rather than scrolling off the top.
command -v fastfetch >/dev/null 2>&1 && fastfetch

# PATH, askpass, gh auth, EDITOR, aliases, the ranger wrapper, sync health.
# bash/bashrc reads the same file.
[ -r "${HOME}/dotfiles/shell/common.sh" ] && source "${HOME}/dotfiles/shell/common.sh"

# X-only settings. profiles/manjaro.conf.yaml deploys this; on WSL it is absent
# and the test is what makes this file identical on both hosts.
[[ -r "${HOME}/.config/zsh/x.zsh" ]] && source "${HOME}/.config/zsh/x.zsh"

# Host-specific aliases — university logins, NAS addresses, partition layouts.
# This repo is public and pushes itself every 20 minutes, so anything naming a
# real host or account belongs in local/, which is gitignored.
[[ -r "${HOME}/dotfiles/local/zshrc.local" ]] && source "${HOME}/dotfiles/local/zshrc.local"
