local/*
!local/.gitkeep

# Machine-local or credential-bearing — never track.
gh/hosts.yml
claude/settings.local.json
claude/.credentials.json
claude/projects/
claude/history.jsonl
*.key
*.pem
*_token
.DS_Store

# Rendered by ~/.config/theme/theme.sh from the .tmpl files beside them. The
# templates are the source; these are output and would churn on every run.
theme/xresources
polybar/config.ini

# Droppings inside directory-linked configs. Those directories are linked whole
# so new files are picked up automatically — which also picks up these.
__pycache__/
*.pyc
*.bak
*.bak-*
