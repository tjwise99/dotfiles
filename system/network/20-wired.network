# The wired link, and only the wired link. iwd does wlan0's IP configuration
# itself (system/iwd/main.conf), so a match reaching the radio would put two
# daemons on one interface.
#
# Name=en* rather than the literal enp4s0: it covers the predictable wired
# names without reaching wlan0, docker0 or a veth pair, and it survives a NIC
# change, whereas a PCI-slot name is a fact about one machine's hardware.

[Match]
Name=en*

[Network]
DHCP=yes

[DHCPv4]
# Wired wins while a cable is in, and wifi takes back over on unplug because
# networkd withdraws this route with the carrier. The number has to beat iwd's,
# which is RoutePriorityOffset plus the interface index — 300 by default, so
# anything under it works and 100 leaves room to slot something between them.
# Left to the two daemons' own defaults this lands the other way round: iwd's
# ~304 beats networkd's 1024, and the cable sits idle.
RouteMetric=100

[Link]
# This port is usually empty, so it must never be a precondition for the machine
# being online — the real link is wlan0, which networkd does not manage. Not on
# its own enough to make systemd-networkd-wait-online usable here: with nothing
# left required, it waits out its timeout rather than returning, which is why
# system/apply.sh disables that unit instead of relying on this line.
RequiredForOnline=no
