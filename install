#!/usr/bin/env bash
set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${BASEDIR}"

detect_host() {
    if grep -qi microsoft /proc/version 2>/dev/null; then
        echo wsl
        return
    fi
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        case "${ID:-}" in
            manjaro | arch) echo manjaro; return ;;
        esac
    fi
    echo unknown
}

# Installing packages is the only step that needs root, so it is opt-in and
# every other step stays runnable unattended. packages/sync-packages.sh reads
# this and says what it skipped rather than skipping quietly.
export DOTFILES_PACKAGES=0
DOTBOT_ARGS=()
for arg in "${@}"; do
    case "${arg}" in
        --packages) DOTFILES_PACKAGES=1 ;;
        *) DOTBOT_ARGS+=("${arg}") ;;
    esac
done

HOST="${DOTFILES_HOST:-$(detect_host)}"

# asdf installs to ~/.local/bin with shims in ~/.asdf/shims. Dotbot's asdf
# directive needs both before ~/.bashrc has ever been sourced.
export PATH="${HOME}/.local/bin:${HOME}/.asdf/shims:${PATH}"

git submodule update --init --recursive

CONFIGS=(profiles/base.conf.yaml)
if [ -f "profiles/${HOST}.conf.yaml" ]; then
    CONFIGS+=("profiles/${HOST}.conf.yaml")
else
    echo "warning: host '${HOST}' has no profile; applying base only" >&2
fi

for config in "${CONFIGS[@]}"; do
    echo "==> ${config}"
    ./dotbot/bin/dotbot -d "${BASEDIR}" \
        --plugin-dir dotbot-plugins/dotbot-asdf -c "${config}" \
        ${DOTBOT_ARGS[@]+"${DOTBOT_ARGS[@]}"}
done
