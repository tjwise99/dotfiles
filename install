#!/usr/bin/env bash
set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${BASEDIR}"

detect_host() {
    if grep -qi microsoft /proc/version 2>/dev/null; then
        echo wsl
        return
    fi
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        case "${ID:-}" in
            manjaro | arch) echo manjaro; return ;;
            nixos) echo nixos; return ;;
        esac
    fi
    echo unknown
}

# The two steps that need root are opt-in, so every other step stays runnable
# unattended. Separately opt-in rather than one flag, because they are not the
# same risk: --packages installs what the manifest declares, --system writes
# files under /etc and enables units. Each script reads its own variable and
# says what it skipped rather than skipping quietly.
export DOTFILES_PACKAGES=0
export DOTFILES_SYSTEM=0
DOTBOT_ARGS=()
for arg in "${@}"; do
    case "${arg}" in
        --packages) DOTFILES_PACKAGES=1 ;;
        --system) DOTFILES_SYSTEM=1 ;;
        *) DOTBOT_ARGS+=("${arg}") ;;
    esac
done

HOST="${DOTFILES_HOST:-$(detect_host)}"

# asdf installs to ~/.local/bin with shims in ~/.asdf/shims. Dotbot's asdf
# directive needs both before ~/.bashrc has ever been sourced.
export PATH="${HOME}/.local/bin:${HOME}/.asdf/shims:${PATH}"

git submodule update --init --recursive

CONFIGS=(profiles/base.conf.yaml)

# Every graphical host applies the same desktop links, so the laptop's desktop
# is one declaration that survives the move between distros rather than a copy
# per host that can drift.
case "${HOST}" in
    manjaro | nixos) CONFIGS+=(profiles/desktop.conf.yaml) ;;
esac

if [ -f "profiles/${HOST}.conf.yaml" ]; then
    CONFIGS+=("profiles/${HOST}.conf.yaml")
else
    echo "warning: host '${HOST}' has no profile; applying base only" >&2
fi

# Every profile runs even when an earlier one fails, and the failure is carried
# to the exit status rather than to the loop. The profiles are independent link
# sets: a package or asdf step failing in base says nothing about whether this
# host's links should be made, and under `set -e` it silently skipped them.
status=0
for config in "${CONFIGS[@]}"; do
    echo "==> ${config}"
    ./dotbot/bin/dotbot -d "${BASEDIR}" \
        --plugin-dir dotbot-plugins/dotbot-asdf -c "${config}" \
        ${DOTBOT_ARGS[@]+"${DOTBOT_ARGS[@]}"} || status=1
done
exit "${status}"
