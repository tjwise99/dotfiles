+// resolveMilestoneRef replaces a milestone:@… token with that milestone's title. ok is false when
+// the reference names no milestone — a number never created, or @current in a repo with nothing
+// open. That is not an error: no issue can be in a milestone that does not exist, so the honest
+// answer is an empty section rather than a failure the user has to dismiss on every repo.
+func resolveMilestoneRef(query string) (string, bool, error) {
+	fields := strings.Fields(query)
+	index := -1
+	number := 0 // 0 is @current, which names a milestone by position rather than by number
+	for position, field := range fields {
+		if !strings.HasPrefix(field, milestoneRefPrefix) {
+			continue
+		}
+		suffix := strings.TrimPrefix(field, milestoneRefPrefix)
+		if suffix != "current" {
+			parsed, err := strconv.Atoi(suffix)
+			if err != nil || parsed < 1 {
+				return "", false, fmt.Errorf(
+					"%s%s is not a milestone reference — use %scurrent, or %sN for milestone number N",
+					milestoneRefPrefix, suffix,
+					milestoneRefPrefix, milestoneRefPrefix,
+				)
+			}
+			number = parsed
+		}
+		index = position
+		break
+	}
+	if index < 0 {
+		return query, true, nil
+	}
+
+	owner, name, found := repoFromQuery(query)
+	if !found {
+		return "", false, fmt.Errorf(
+			"%s needs a repo: to resolve against — open gh-dash inside a clone, or name one in the filter",
+			milestoneRefPrefix,
+		)
+	}
+	milestones, err := fetchMilestones(owner, name)
+	if err != nil {
+		return "", false, err
+	}
+
+	title, matched := "", false
+	for _, milestone := range milestones {
+		// milestones is in milestoneLess order, so the first open one is @current.
+		if (number == 0 && milestone.State == "OPEN") || (number != 0 && milestone.Number == number) {
+			title, matched = milestone.Title, true
+			break
+		}
+	}
+	if !matched {
+		log.Info("milestone reference names no milestone",
+			"repo", owner+"/"+name, "ref", fields[index], "milestones", len(milestones))
+		return "", false, nil
+	}
