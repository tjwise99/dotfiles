+// GitHub's search index does not carry issue dependencies. Repository-scoped, `is:blocked` matches
+// nothing; unscoped it degrades to a text match on the word, so `-is:blocked` sent to the API
+// returns every open issue whether or not any is blocked. The token is stripped from the query and
+// applied to the fetched rows instead, which is the only place it can be applied at all.
+const blockedFilterToken = "is:blocked"
+
+// The GraphQL maximum. A filtered section pages to exhaustion, so this sizes round trips, not rows.
+const blockedFilterPageSize = 100
+
+// Bounds that exhaustion. Reaching it means the result is short, which is logged rather than
+// quietly presented as complete.
+const blockedFilterPageCap = 20
+
+// extractBlockedFilter returns the query stripped of the dependency token, and what the token
+// asked for: true for blocked issues, false for unblocked, nil when the query did not mention it.
+func extractBlockedFilter(query string) (string, *bool) {
+	var want *bool
+	kept := make([]string, 0)
+	for _, field := range strings.Fields(query) {
+		switch field {
+		case blockedFilterToken:
+			blocked := true
+			want = &blocked
+		case "-" + blockedFilterToken:
+			blocked := false
+			want = &blocked
+		default:
+			kept = append(kept, field)
+		}
+	}
+	return strings.Join(kept, " "), want
+}
+
+// fetchIssuesByDependency pages the search to exhaustion before filtering, because the count and
+// the rows have to agree. Filtering one page in isolation reports a total that counts issues the
+// section does not list, and applying the section's limit before the filter would hide ready
+// issues behind blocked ones that merely sorted earlier.
+//
+// The section's limit is deliberately not applied: with the filter running here, the honest
+// choices were to ignore it or to report a count that disagrees with the rows on screen.
+func fetchIssuesByDependency(query string, wantBlocked bool) (IssuesResponse, error) {
+	matched := make([]IssueData, 0)
+	var endCursor *string
+
+	for page := 0; page < blockedFilterPageCap; page++ {
+		var queryResult struct {
+			Search struct {
+				Nodes []struct {
+					Issue IssueData `graphql:"... on Issue"`
+				}
+				IssueCount int
+				PageInfo   PageInfo
+			} `graphql:"search(type: ISSUE, first: $limit, after: $endCursor, query: $query)"`
+		}
+		variables := map[string]any{
+			"query":     graphql.String(makeIssuesQuery(query)),
+			"limit":     graphql.Int(blockedFilterPageSize),
+			"endCursor": (*graphql.String)(endCursor),
+		}
+		if err := client.Query("SearchIssues", &queryResult, variables); err != nil {
+			return IssuesResponse{}, err
+		}
+		// Filtering client-side means every match has to be walked, so a search this wide cannot
+		// be answered correctly at all — an unscoped section outside a clone reaches here. Saying
+		// so costs one request; the alternative is twenty requests and a plausible wrong list.
+		if page == 0 && queryResult.Search.IssueCount > blockedFilterPageCap*blockedFilterPageSize {
+			return IssuesResponse{}, fmt.Errorf(
+				"%s needs a narrower filter: it matches %d issues and dependencies are filtered "+
+					"locally, so at most %d can be read",
+				blockedFilterToken, queryResult.Search.IssueCount,
+				blockedFilterPageCap*blockedFilterPageSize,
+			)
+		}
+		for _, node := range queryResult.Search.Nodes {
+			if (node.Issue.IssueDependenciesSummary.BlockedBy > 0) == wantBlocked {
+				matched = append(matched, node.Issue)
+			}
+		}
+		if !queryResult.Search.PageInfo.HasNextPage {
+			log.Info("Successfully fetched issues", "query", query, "count", len(matched))
+			// HasNextPage stays false: the pages walked here are the search's, and the section
+			// cannot resume from a cursor whose rows it never saw.
+			return IssuesResponse{Issues: matched, TotalCount: len(matched)}, nil
+		}
+		cursor := queryResult.Search.PageInfo.EndCursor
+		endCursor = &cursor
+	}
+
+	log.Warn(
+		"Dependency-filtered search hit its page cap; this result is incomplete",
+		"query", query, "pages", blockedFilterPageCap, "matched", len(matched),
+	)
+	return IssuesResponse{Issues: matched, TotalCount: len(matched)}, nil
+}
