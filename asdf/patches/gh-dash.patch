+// fetchMilestones returns every milestone the repo has, open and closed, in milestoneLess order.
+func fetchMilestones(owner, name string) ([]milestoneNode, error) {
+	// Self-contained rather than relying on FetchIssues having run first: reaching the API
+	// through a nil client panics, and a panic here would take the whole dash down.
+	if client == nil {
+		var err error
+		if client, err = gh.DefaultGraphQLClient(); err != nil {
+			return nil, err
+		}
+	}
