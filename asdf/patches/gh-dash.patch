+					// across pages; the set is reordered by milestoneLess once complete.
+				} `graphql:"milestones(first: $limit, after: $endCursor, states: [OPEN, CLOSED], orderBy: {field: NUMBER, direction: ASC})"`
+			} `graphql:"repository(owner: $owner, name: $name)"`
+		}
+		variables := map[string]any{
+			"owner":     graphql.String(owner),
+			"name":      graphql.String(name),
