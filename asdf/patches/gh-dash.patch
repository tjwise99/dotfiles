+		if !a.DueOn.Equal(*b.DueOn) {
+			return a.DueOn.Before(*b.DueOn)
+		}
+	case a.DueOn != nil:
+		return true
+	case b.DueOn != nil:
+		return false
+	}
+	return a.Number < b.Number
