+// extractBlockedFilter returns the query stripped of the dependency token, and what the token
+// asked for: true for blocked issues, false for unblocked, nil when the query did not mention it.
+func extractBlockedFilter(query string) (string, *bool) {
+	var want *bool
+	kept := make([]string, 0)
+	for _, field := range strings.Fields(query) {
+		switch field {
+		case blockedFilterToken:
+			blocked := true
+			want = &blocked
+		case "-" + blockedFilterToken:
+			blocked := false
+			want = &blocked
+		default:
+			kept = append(kept, field)
+		}
+	}
+	return strings.Join(kept, " "), want
