+func repoFromQuery(query string) (string, string, bool) {
+	for _, field := range strings.Fields(query) {
+		if !strings.HasPrefix(field, "repo:") {
+			continue
+		}
+		owner, name, found := strings.Cut(strings.TrimPrefix(field, "repo:"), "/")
+		if found && owner != "" && name != "" {
+			return owner, name, true
+		}
+	}
+	return "", "", false
+}
