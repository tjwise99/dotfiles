+/// Split one diff line into display fragments no wider than `content_width`.
+/// Every fragment keeps the original's line numbers so a comment anchors from
+/// any of them; `wrap_spans` never splits mid-word, so a single word longer
+/// than the width still overflows rather than being cut.
+fn wrap_diff_line(line: &DiffLine, content_width: usize) -> Vec<DiffLine> {
+    if content_width == 0 || line.content.width() <= content_width {
+        return vec![line.clone()];
+    }
+
+    let spans: Vec<Span<'static>> = match &line.highlighted_content {
+        Some(highlighted) => highlighted.spans.clone(),
+        None => vec![Span::raw(line.content.clone())],
+    };
+
+    wrap_spans(&spans, content_width)
+        .into_iter()
+        .map(|fragment| DiffLine {
+            kind: line.kind.clone(),
+            old_lineno: line.old_lineno,
+            new_lineno: line.new_lineno,
+            content: fragment.spans.iter().map(|s| s.content.as_ref()).collect(),
+            highlighted_content: Some(fragment),
+        })
+        .collect()
+}
