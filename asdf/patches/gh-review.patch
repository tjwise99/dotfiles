+        let flags: Vec<bool> = rows
+            .iter()
+            .filter_map(|r| match r {
+                DisplayRow::DiffLine { wrapped, .. } => Some(*wrapped),
+                _ => None,
+            })
+            .collect();
+        assert!(flags.len() > 1, "the line should have wrapped");
+        assert_eq!(flags[0], false, "the first fragment owns the line numbers");
+        assert!(
+            flags[1..].iter().all(|w| *w),
+            "every later fragment is a continuation, got {flags:?}"
+        );
+    }
+}
