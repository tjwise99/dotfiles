{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "teammateMode": "auto"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(//tmp/claude-1000/**)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(git fetch:*)",
      "Bash(magick identify:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git worktree list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh api:*)",
      "Bash(just check-reqs:*)",
      "Bash(just --list:*)",
      "Bash(just verify:*)",
      "Bash(just check-links:*)",
      "Bash(just check-site:*)",
      "Bash(just check-eol:*)",
      "Bash(just check-arch:*)",
      "Bash(just check-citations:*)",
      "Bash(just check-adr-index:*)",
      "Bash(just check-adr-revs:*)",
      "Bash(just check-arch-trace:*)",
      "Bash(just check-verify-ci-parity:*)",
      "Bash(just tools:*)",
      "Bash(just justfiles:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git grep:*)",
      "Bash(git check-ignore:*)",
      "Bash(git ls-tree:*)",
      "Bash(git remote -v)",
      "Bash(gh issue list:*)",
      "Bash(gh pr list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh label list:*)",
      "Bash(gh auth status)",
      "Bash(/usr/bin/grep:*)",
      "Bash(/bin/grep:*)",
      "Bash(/usr/bin/sed:*)",
      "Bash(docs/requirements/.venv/bin/python:*)",
      "Bash(docs/requirements/.venv/bin/doorstop:*)",
      "Write(//tmp/claude-1000/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/claude/guard-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/claude/guard-publish.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/claude/guard-read.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "orchestrate|work-ticket",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/claude/orchestrator-toggle.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/claude/host-facts.sh",
            "timeout": 15,
            "statusMessage": "Resolving host facts"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/tools/sync.sh",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/dotfiles/claude/orchestrator-cleanup.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "env PATH=\"$HOME/.local/bin:$HOME/.asdf/shims:$PATH\" ccstatusline"
  },
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true
}
