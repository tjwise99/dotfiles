# GENERATED from ~/.config/theme/alacritty.toml.tmpl by theme.sh
# Edit the template, not this file.
# live_config_reload is set explicitly below: the documented default of true was
# not in effect here, and open windows did not repaint until it was written out.

[general]
live_config_reload = true

[env]
TERM = "alacritty"

[font]
size = 12.0

[font.normal]
family = "JetBrainsMono Nerd Font"
style = "Regular"

[font.bold]
family = "JetBrainsMono Nerd Font"
style = "Bold"

[font.italic]
family = "JetBrainsMono Nerd Font"
style = "Italic"

[scrolling]
history = 100000
multiplier = 3

[window]
padding = { x = 8, y = 8 }
dynamic_padding = true

[colors.primary]
background = "@term_bg@"
foreground = "@term_fg@"

[colors.cursor]
text   = "@term_bg@"
cursor = "@accent@"

[colors.selection]
text       = "@accent_fg@"
background = "@accent@"

[colors.normal]
black   = "@color0@"
red     = "@color1@"
green   = "@color2@"
yellow  = "@color3@"
blue    = "@color4@"
magenta = "@color5@"
cyan    = "@color6@"
white   = "@color7@"

[colors.bright]
black   = "@color8@"
red     = "@color9@"
green   = "@color10@"
yellow  = "@color11@"
blue    = "@color12@"
magenta = "@color13@"
cyan    = "@color14@"
white   = "@color15@"
