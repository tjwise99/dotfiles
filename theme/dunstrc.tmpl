# GENERATED from ~/.config/theme/dunstrc.tmpl by theme.sh
# Edit the template, not this file.

[global]
    monitor = 0
    follow = none
    origin = top-right
    offset = (12, 12)
    width = (240, 420)
    height = (0, 300)
    notification_limit = 5
    gap_size = 6

    padding = @padding@
    horizontal_padding = @hpadding@
    frame_width = @frame_width@
    corner_radius = @corner_radius@
    text_icon_padding = 10

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1

    font = @font@
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    icon_position = left
    min_icon_size = 20
    max_icon_size = 32
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark

    sort = urgency_descending
    idle_threshold = 120
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "@dunst_bg_low@"
    foreground = "@dunst_fg_low@"
    frame_color = "@dunst_frame_low@"
    timeout = 5

[urgency_normal]
    background = "@dunst_bg@"
    foreground = "@fg@"
    frame_color = "@accent@"
    timeout = 8

[urgency_critical]
    background = "@dunst_bg@"
    foreground = "@fg@"
    frame_color = "@urgent@"
    timeout = 0
