; GENERATED from ~/.config/theme/polybar.ini.tmpl by theme.sh
; Edit the template, not this file.
[bar/main]
monitor = eDP-1
bottom = true
width = 100%
height = 27
background = @bar_bg@
foreground = @fg@
padding-right = 1
module-margin = 4px
cursor-click = pointer
enable-ipc = true

font-0 = JetBrainsMono Nerd Font:size=11;3
font-1 = JetBrainsMono Nerd Font:size=12;3

modules-left = i3
modules-right = tray fs-root fs-home load memory network-eth network-wifi pulseaudio battery date

[module/i3]
type = internal/i3
pin-workspaces = true
strip-wsnumbers = true
enable-click = true
enable-scroll = false
label-focused = %name%
label-focused-foreground = @accent_fg@
label-focused-background = @accent@
label-focused-padding = 1
label-unfocused = %name%
label-unfocused-foreground = @muted@
label-unfocused-padding = 1
label-visible = %name%
label-visible-padding = 1
label-urgent = %name%
label-urgent-background = @urgent@
label-urgent-padding = 1

[module/fs-root]
type = internal/fs
mount-0 = /
interval = 60
label-mounted = %{F@glyph@}%{T2}%{T-}%{F-} %free%

[module/fs-home]
type = internal/fs
mount-0 = /home
interval = 60
label-mounted = %{F@glyph@}%{T2}%{T-}%{F-} %free%

[module/load]
type = custom/script
exec = awk '{print $1}' /proc/loadavg
interval = 5
label = %{F@glyph@}%{T2}%{T-}%{F-} %output%

[module/memory]
type = internal/memory
interval = 5
label = %{F@glyph@}%{T2}%{T-}%{F-} %gb_free%

[module/pulseaudio]
type = internal/pulseaudio
interval = 5
use-ui-max = false
format-volume = %{A3:pavucontrol:}<ramp-volume> <label-volume>%{A}
format-muted = %{A3:pavucontrol:}<label-muted>%{A}
label-muted = %{T2}%{T-} %percentage%%
label-volume = %percentage%%
label-muted-foreground = @muted@
ramp-volume-0 = %{F@glyph@}%{T2}%{T-}%{F-}
ramp-volume-1 = %{F@glyph@}%{T2}%{T-}%{F-}
ramp-volume-2 = %{F@glyph@}%{T2}%{T-}%{F-}

[module/date]
type = internal/date
interval = 30
date = %H:%M
date-alt = %a %Y-%m-%d %H:%M
label = %{A3:gsimplecal:}%{F@glyph@}%{T2}%{T-}%{F-} %date%%{A}

[module/battery]
type = internal/battery
battery = BAT0
adapter = AC
full-at = 99
poll-interval = 5
format-charging = %{F@glyph@}%{T2}%{T-}%{F-} <label-charging>
format-discharging = <ramp-capacity> <label-discharging>
format-full = %{F@glyph@}%{T2}%{T-}%{F-} <label-full>
label-charging = %percentage%%
label-discharging = %percentage%%
label-full = %percentage%%
ramp-capacity-0 = %{F@glyph@}%{T2}%{T-}%{F-}
ramp-capacity-1 = %{F@glyph@}%{T2}%{T-}%{F-}
ramp-capacity-2 = %{F@glyph@}%{T2}%{T-}%{F-}
ramp-capacity-3 = %{F@glyph@}%{T2}%{T-}%{F-}
ramp-capacity-4 = %{F@glyph@}%{T2}%{T-}%{F-}

[module/network-wifi]
type = internal/network
interface-type = wireless
interval = 5
format-connected = %{A1:alacritty -e impala:}<ramp-signal> <label-connected>%{A}
format-disconnected = %{A1:alacritty -e impala:}%{F@glyph@}%{T2}󰤭%{T-}%{F-}%{A}
label-connected = %signal%%
ramp-signal-0 = %{F@glyph@}%{T2}󰤟%{T-}%{F-}
ramp-signal-1 = %{F@glyph@}%{T2}󰤢%{T-}%{F-}
ramp-signal-2 = %{F@glyph@}%{T2}󰤥%{T-}%{F-}
ramp-signal-3 = %{F@glyph@}%{T2}󰤨%{T-}%{F-}

[module/network-eth]
type = internal/network
interface-type = wired
interval = 5
format-connected = %{F@glyph@}%{T2}󰈀%{T-}%{F-}
format-disconnected =

[module/tray]
type = internal/tray
tray-size = 85%
tray-spacing = 6
tray-padding = 2
