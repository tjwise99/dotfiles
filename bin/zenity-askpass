#!/bin/sh
# SSH_ASKPASS / SUDO_ASKPASS helper. Both pass the prompt as $1 and read the
# answer from stdout; ssh host-key prompts want a yes/no line, everything else
# a secret. sudo only consults SUDO_ASKPASS when invoked with -A.
prompt="${1:-Password:}"

case "$prompt" in
  *yes/no*)
    if zenity --question --title="SSH host key" --text="$prompt" 2>/dev/null; then
      echo yes
    else
      echo no
    fi
    ;;
  *)
    zenity --entry --hide-text --title="Authentication" --text="$prompt" 2>/dev/null
    ;;
esac
